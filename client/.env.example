# Set this to your deployed backend base URL
# Example: VITE_API_BASE_URL=/api
# The frontend uses /auth/register and /auth/login on the backend
VITE_API_BASE_URL=/api

# Cashfree environment: LIVE for production, TEST for sandbox
VITE_CASHFREE_ENV=LIVE

# Cashfree redirect return URL for the front-end payment status page
# Example: https://www.clutchzone.in/payment-status
VITE_CASHFREE_RETURN_URL=https://www.clutchzone.in/payment-status

